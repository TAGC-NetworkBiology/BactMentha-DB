# -*- coding: utf-8 -*-
#!/bin/bash

# -----------------------------------------------------------------------------------------------------
# Environment file to set some variables used in the docker-compose.yml file for the BactMentha Project
# -----------------------------------------------------------------------------------------------------

# -----
# | 1 | Connexion variables for Postgres connection
# ----- -------------------------------------------

POSTGRES_PASSWORD=postgres
POSTGRES_DB=bactmentha_db
POSTGRES_USER=postgres
# DB_PORTS=5432                     #(default)
# PGDATA=/var/lib/postgresql/data   #(default)


# -----
# | 2 | Path to the BactMentha_DB project folder / mounted volume for bactmentha_python3 container
# ----- ------------------------------------------------------------------------------------------

PROJECT_PATH=/home/bergogne/Documents/BactMentha_DB


# -----
# | 3 | Path to the python scripts used in the bactmentha_python3 container command at its creation
# ----- -------------------------------------------------------------------------------------------

CREATEDB_SCRIPT='/BactMentha/03_Script/01_db_creation_and_update/createdb.py'
INSERTDATA_SCRIPT='/BactMentha/03_Script/01_db_creation_and_update/insertdata.py'
UPDATEDB_SCRIPT='/BactMentha/03_Script/01_db_creation_and_update/updatedb.py'

# /!\ They will run inside python container so it has to be the path from inside bactmentha_python3 (or whatever name you gave it) container

# -----
# | 4| Path to the mounted volumes for bactmentha_nginx container
# ----------------------------------------------------------------

WEBSITE_FOLDER_PATH=/home/bergogne/Documents/BactMentha_DB/03_Script/02_Website
NGINX_CONF_PATH=/home/bergogne/Documents/BactMentha_DB/02_Container/Compose_postgres_python/03_nginx/conf/nginx.conf


# -----
# | 5 | Path to the mounted volumes for bactmentha_php container
# --------------------------------------------------------------

PHP_WEBSITE_FOLDER_PATH=/home/bergogne/Documents/BactMentha_DB/03_Script/02_Website
DATABASE_FOLDER_PATH=/home/bergogne/Documents/BactMentha_DB/05_Output/01_Database
PHP_ARCHIVE_PATH=/home/bergogne/Documents/BactMentha_DB/05_Output/02_Archive
PHP_DOWNLOAD_PATH=/home/bergogne/Documents/BactMentha_DB/03_Script/02_Website/static/tmp


# -----
# | 6 | Choice of the command to run for python when the container starts
# ----- -----------------------------------------------------------------

# Chose a command number in the following ones:
# COMMAND=0 : python doesn't execute any command when starting
# COMMAND=1 : python executes the command for the creation of the database tables only (call it once if the database is empty)
# COMMAND=2 : python executes the command for the data insertion only (fills the database with new data if not exist in the database)
#             If all your database tables has been droped (including metadata table), you might run this script before the update to fill the tables again.
# COMMAND=3 : python executes the command for the update of the database (fills the database with new data and creates an 
#             archive of the new version) : call it once after the database creation script then set it by default for updates.

COMMAND=0


# NB: some environment varibles are written with or without quotes:
# - without quotes: variables that are used directly inside the docker-compose.yml file (mainly for mounted volumes).
# - with quotes: variables that are used in some command lines (at a container creation or inside a script).
